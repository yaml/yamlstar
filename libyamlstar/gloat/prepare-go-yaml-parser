#!/usr/bin/env bash
set -euo pipefail

src=${1:?source go-yaml directory required}
dst=${2:?destination package directory required}

pkg_src=$src/internal/libyaml
for file in yaml.go errors.go reader.go scanner.go parser.go; do
  test -f "$pkg_src/$file"
done

rm -rf "$dst"
mkdir -p "$dst"

for file in yaml.go errors.go reader.go scanner.go parser.go; do
  perl -0pe 's/\bpackage libyaml\b/package goyamlparser/' \
    < "$pkg_src/$file" > "$dst/$file"
done

cat > "$dst/support.go" <<'GO'
package goyamlparser

import "fmt"

type Style uint32

type DepthKind string

const (
	DepthKindFlow  DepthKind = "flow"
	DepthKindBlock DepthKind = "block"
)

type DepthContext struct {
	Kind DepthKind
}

func DefaultDepthCheck(depth int, ctx *DepthContext) error {
	const maxDepth = 10000
	if depth > maxDepth {
		return fmt.Errorf("exceeded max depth of %d", maxDepth)
	}
	return nil
}

type Composer struct {
	Parser Parser
}

func NewComposer(in []byte, options any) *Composer {
	parser := NewParser()
	parser.SetInputString(in)
	return &Composer{Parser: parser}
}

func (c *Composer) Destroy() {}

func (e *Event) Delete() {}
GO

cat > "$dst/adapter.go" <<'GO'
package goyamlparser

import (
	"encoding/json"
	"fmt"
	"io"
	"strings"
)

func ParseYAMLStarEvents(input string) (string, error) {
	if input == "" {
		input = "\n"
	} else if !strings.HasSuffix(input, "\n") {
		input += "\n"
	}

	parser := NewParser()
	parser.SetInputString([]byte(input))
	defer parser.Delete()

	events := []map[string]any{}
	for {
		var event Event
		err := parser.Parse(&event)
		if err == io.EOF {
			break
		}
		if err != nil {
			return "", err
		}
		if item := yamlstarEvent(&event); item != nil {
			events = append(events, item)
		}
		if event.Type == STREAM_END_EVENT {
			break
		}
	}

	data, err := json.Marshal(events)
	if err != nil {
		return "", err
	}
	return string(data), nil
}

func yamlstarEvent(event *Event) map[string]any {
	switch event.Type {
	case STREAM_START_EVENT:
		return map[string]any{"event": "stream_start"}
	case STREAM_END_EVENT:
		return map[string]any{"event": "stream_end"}
	case DOCUMENT_START_EVENT:
		item := map[string]any{"event": "document_start"}
		if !event.Implicit {
			item["explicit"] = true
		}
		if version := event.GetVersionDirective(); version != nil {
			item["version"] = fmt.Sprintf("%d.%d", version.Major(), version.Minor())
		}
		return item
	case DOCUMENT_END_EVENT:
		item := map[string]any{"event": "document_end"}
		if !event.Implicit {
			item["explicit"] = true
		}
		return item
	case MAPPING_START_EVENT:
		item := nodeStartEvent("mapping_start", event)
		if event.MappingStyle() == FLOW_MAPPING_STYLE {
			item["flow"] = true
		}
		return item
	case MAPPING_END_EVENT:
		return map[string]any{"event": "mapping_end"}
	case SEQUENCE_START_EVENT:
		item := nodeStartEvent("sequence_start", event)
		if event.SequenceStyle() == FLOW_SEQUENCE_STYLE {
			item["flow"] = true
		}
		return item
	case SEQUENCE_END_EVENT:
		return map[string]any{"event": "sequence_end"}
	case SCALAR_EVENT:
		item := nodeStartEvent("scalar", event)
		item["value"] = string(event.Value)
		if style := scalarStyle(event.ScalarStyle()); style != "" {
			item["style"] = style
		}
		return item
	case ALIAS_EVENT:
		return map[string]any{"event": "alias", "name": string(event.Anchor)}
	default:
		return nil
	}
}

func nodeStartEvent(name string, event *Event) map[string]any {
	item := map[string]any{"event": name}
	if len(event.Anchor) > 0 {
		item["anchor"] = string(event.Anchor)
	}
	if tag := normalizeTag(string(event.Tag)); tag != "" {
		item["tag"] = tag
	}
	return item
}

func scalarStyle(style ScalarStyle) string {
	switch style {
	case SINGLE_QUOTED_SCALAR_STYLE:
		return "single"
	case DOUBLE_QUOTED_SCALAR_STYLE:
		return "double"
	case LITERAL_SCALAR_STYLE:
		return "literal"
	case FOLDED_SCALAR_STYLE:
		return "folded"
	default:
		return ""
	}
}

func normalizeTag(tag string) string {
	const prefix = "tag:yaml.org,2002:"
	if strings.HasPrefix(tag, prefix) {
		return "!!" + strings.TrimPrefix(tag, prefix)
	}
	return tag
}
GO

touch "$dst/.generated"
