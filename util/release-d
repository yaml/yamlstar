#!/usr/bin/env bash

lang=d
tag_prefix=v
root=$(cd "$(dirname "$0")/.." && pwd)

dub_secret() {
  local secret=${DUB_UPDATE_SECRET:-}
  local secrets_file=${YS_SECRETS_FILE:-$HOME/.yamlscript-secrets.yaml}
  if [[ -z $secret ]]; then
    secret=$(
      awk '
        $1 == "d:" { in_d = 1; next }
        in_d && $0 ~ /^[^[:space:]]/ { in_d = 0 }
        in_d && $1 == "token:" {
          sub(/^[[:space:]]*token:[[:space:]]*/, "")
          gsub(/^[\047"]|[\047"]$/, "")
          print
          exit
        }
      ' "$secrets_file" 2>/dev/null || true
    )
  fi
  printf '%s' "$secret"
}

update() (
  cp "$root/License" "$repo_dir/LICENSE"

  cd "$from_dir" || exit
  cp ReadMe.md dub.json "$repo_dir/"
  mkdir -p "$repo_dir/source"
  cp source/*.d "$repo_dir/source/"
)

after_release() (
  local secret
  secret=$(dub_secret)

  if [[ ${YS_RELEASE_DRYRUN-} || ${YS_RELEASE_DRY_RUN-} ]]; then
    echo 'X - curl -X POST https://code.dlang.org/api/packages/yamlstar/update'
    return
  fi

  [[ $secret ]] || {
    echo 'Error: DUB_UPDATE_SECRET or .d.token must be set' >&2
    exit 1
  }

  local response
  response=$(curl --fail-with-body -sS -X POST \
      https://code.dlang.org/api/packages/yamlstar/update \
      -H 'Content-Type: application/json' \
      -d "$(jq -cn --arg secret "$secret" '{secret: $secret}')")
  if [[ $response == *'Invalid secret'* ]]; then
    echo 'Error: code.dlang.org rejected DUB_UPDATE_SECRET' >&2
    return 1
  fi
)

source "$(dirname "$0")/release-repo.bash"
