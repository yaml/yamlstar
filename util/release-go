#!/usr/bin/env bash

lang=go
tag_prefix=v  # Go requires v prefix
root=$(cd "$(dirname "$0")/.." && pwd)

update() (
  cp "$root/License" "$repo_dir/LICENSE"

  cd "$from_dir" || exit
  cp \
    ReadMe.md \
    go.mod \
    go.sum \
    yamlstar.go \
    yamlstar_test.go \
    "$repo_dir/"

  cp -r examples "$repo_dir/"

  # The monorepo uses a local replace for development. Published yamlstar-go
  # releases depend on the matching root YAMLStar Go module tag.
  perl -pi -e \
    "s{github.com/yaml/yamlstar v0\\.0\\.0}{github.com/yaml/yamlstar v$version}" \
    "$repo_dir/go.mod"
  perl -ni -e \
    'print unless m{^replace github\.com/yaml/yamlstar => \.\.$}' \
    "$repo_dir/go.mod"
)

test() (
  cd "$repo_dir" || exit
  go mod tidy
  go test ./...
)

source "$(dirname "$0")/release-repo.bash"
