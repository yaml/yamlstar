#!/usr/bin/env bash

set -euo pipefail

if (($# != 4)); then
  echo "Usage: $0 NAME DIRECTORY COMMIT CACHE-DIRECTORY" >&2
  exit 2
fi

name=$1
source_dir=$2
requested_commit=$3
cache_dir=$4

if [[ ! $name =~ ^[a-z0-9-]+$ ]]; then
  echo "Invalid local source name: $name" >&2
  exit 2
fi

if [[ ! -d $source_dir ]]; then
  echo "$name directory does not exist: $source_dir" >&2
  exit 1
fi

source_dir=$(cd "$source_dir" && pwd -P)
if ! git -C "$source_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "$name directory is not a Git checkout: $source_dir" >&2
  exit 1
fi

if ! commit=$(
  git -C "$source_dir" rev-parse --verify "$requested_commit^{commit}" 2>/dev/null
); then
  echo "$name commit is not available in $source_dir: $requested_commit" >&2
  exit 1
fi

head=$(git -C "$source_dir" rev-parse HEAD)
if [[ $commit == "$head" ]]; then
  description=$(git -C "$source_dir" describe --tags --always --dirty)
  echo "Using live $name source: $source_dir ($description)" >&2
  printf '%s\n' "$source_dir"
  exit 0
fi

cache_dir=$(mkdir -p "$cache_dir" && cd "$cache_dir" && pwd -P)
target=$cache_dir/sources/$name/$commit

if [[ -d $target/.git ]]; then
  cached_commit=$(git -C "$target" rev-parse HEAD 2>/dev/null || true)
  if [[ $cached_commit == "$commit" ]]; then
    git -C "$target" reset --hard --quiet "$commit"
    git -C "$target" clean -fdq
    echo "Using cached $name source: $target ($commit)" >&2
    printf '%s\n' "$target"
    exit 0
  fi
fi

parent=$(dirname "$target")
mkdir -p "$parent"
temporary=$parent/.tmp-"$commit"-$$
trap 'rm -rf "$temporary"' EXIT
rm -rf "$temporary"

git clone --quiet --no-checkout -- "$source_dir" "$temporary"
git -C "$temporary" -c advice.detachedHead=false \
  checkout --quiet --detach "$commit"

rm -rf "$target"
mv "$temporary" "$target"
trap - EXIT

echo "Created cached $name source: $target ($commit)" >&2
printf '%s\n' "$target"
